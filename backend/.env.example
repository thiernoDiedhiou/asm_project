# Base de données PostgreSQL
DATABASE_URL="postgresql://asm_user:asm_password@localhost:5432/location"

# JWT Secrets (générer avec: openssl rand -base64 64)
JWT_SECRET="votre_secret_jwt_tres_long_et_securise_a_changer_en_production"
JWT_REFRESH_SECRET="votre_secret_refresh_jwt_different_du_premier_a_changer"
JWT_EXPIRY="15m"
REFRESH_EXPIRY="7d"

# Serveur
PORT=5000
NODE_ENV="production"
# Prod: https://{slug}.location.innosft.com (wildcard — 1er tenant actif en fallback)
FRONTEND_URL="https://admin.location.innosft.com"

# Domaine racine — TOUS les sous-domaines *.location.innosft.com sont autorisés par le CORS
PLATFORM_DOMAIN="location.innosft.com"

# URL du panel Super Admin
SUPERADMIN_URL="https://admin.location.innosft.com"

# URL de base de l'API — pour construire les liens emails (reset-password, QR codes PDF)
# En prod: même domaine, nginx proxy — utiliser le 1er tenant ou laisser vide
API_URL="https://admin.location.innosft.com"

# Fichiers uploadés
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Puppeteer (génération PDF) — sur VPS Linux, Chromium est installé séparément
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD="false"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"

# Notifications email (Nodemailer / Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="votre_email@gmail.com"
SMTP_PASS="votre_app_password_gmail"
SMTP_FROM="Innosoft Creation <votre_email@gmail.com>"
ADMIN_EMAIL="votre_email@gmail.com"
