// ============================================================
// SCHÉMA PRISMA - Plateforme SaaS Multi-Tenant
// Location de Véhicules — Architecture multi-entreprises
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum Role {
  SUPER_ADMIN  // Administrateur de la plateforme (vous)
  ADMIN        // Administrateur d'un tenant
  AGENT
  COMPTABLE
}

enum Categorie {
  ECONOMIQUE
  STANDARD
  SUV
  LUXE
  UTILITAIRE
}

enum StatutVehicule {
  DISPONIBLE
  LOUE
  EN_MAINTENANCE
  HORS_SERVICE
}

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  VIP
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum TypeTrajet {
  LOCATION
  TRANSFERT_AEROPORT
  LONGUE_DUREE
}

enum StatutContrat {
  ACTIF
  TERMINE
  LITIGE
}

enum MethodePaiement {
  ESPECES
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  VIREMENT
  CHEQUE
}

enum StatutMaintenance {
  PLANIFIEE
  EN_COURS
  TERMINEE
}

// ---- Tenant (entreprise cliente de la plateforme) ----

model Tenant {
  id                String    @id @default(uuid())
  slug              String    @unique   // "asm", "autocity" — identifie le sous-domaine
  domaine           String?   @unique   // Domaine custom: "asm-location.sn"
  nomEntreprise     String
  slogan            String    @default("Location de Véhicules")
  activite          String    @default("Location de véhicules")
  couleurPrimaire   String    @default("#1B5E20")
  couleurSecondaire String    @default("#F9A825")
  logo              String?
  actif             Boolean   @default(true)
  // Abonnement
  planType          String    @default("STARTER")  // STARTER, PRO, ENTERPRISE
  montantMensuel    Decimal?  @db.Decimal(10, 2)
  dateExpiration    DateTime?
  statutAbonnement  String    @default("ACTIF")    // ACTIF, EXPIRE, SUSPENDU
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  users               User[]
  vehicules           Vehicule[]
  clients             Client[]
  reservations        Reservation[]
  contrats            Contrat[]
  paiements           Paiement[]
  maintenances        Maintenance[]
  journal             JournalActivite[]
  tarifZones          TarifZone[]
  prixCategories      PrixCategorie[]
  parametre           Parametre?
  paiementsAbonnement PaiementAbonnement[]

  @@map("tenants")
}

// ---- Utilisateurs ----

model User {
  id           String        @id @default(uuid())
  nom          String
  prenom       String
  email        String
  motDePasse   String
  telephone    String?
  role         Role          @default(AGENT)
  actif             Boolean       @default(true)
  resetToken        String?       @unique
  resetTokenExpiry  DateTime?
  tenantId          String?       // NULL pour SUPER_ADMIN (cross-tenant)
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservations Reservation[]
  contrats     Contrat[]

  @@unique([email, tenantId])  // Un email peut exister dans deux tenants différents
  @@index([tenantId])
  @@map("users")
}

// ---- Véhicules ----

model Vehicule {
  id              String         @id @default(uuid())
  marque          String
  modele          String
  annee           Int
  immatriculation String
  couleur         String
  categorie       Categorie
  kilometrage     Int            @default(0)
  prixJournalier  Decimal        @db.Decimal(10, 2)
  prixSemaine     Decimal        @db.Decimal(10, 2)
  statut          StatutVehicule @default(DISPONIBLE)
  photos          String[]
  description     String?
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  maintenances    Maintenance[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([immatriculation, tenantId])  // Immatriculation unique par tenant
  @@index([tenantId])
  @@map("vehicules")
}

// ---- Clients ----

model Client {
  id              String        @id @default(uuid())
  nom             String
  prenom          String
  email           String?
  telephone       String
  adresse         String?
  typeClient      TypeClient    @default(PARTICULIER)
  societe         String?
  numeroCNI       String?
  numeroPasseport String?
  permisConduire  String?
  notes           String?
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  contrats        Contrat[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@map("clients")
}

// ---- Réservations ----

model Reservation {
  id                 String            @id @default(uuid())
  numeroReservation  String
  client             Client            @relation(fields: [clientId], references: [id])
  clientId           String
  vehicule           Vehicule          @relation(fields: [vehiculeId], references: [id])
  vehiculeId         String
  dateDebut          DateTime
  dateFin            DateTime
  lieuPriseEnCharge  String
  lieuRetour         String
  nombreJours        Int
  prixTotal          Decimal           @db.Decimal(10, 2)
  avance             Decimal           @default(0) @db.Decimal(10, 2)
  statut             StatutReservation @default(EN_ATTENTE)
  typeTrajet         TypeTrajet        @default(LOCATION)
  notes              String?
  agentId            String
  agent              User              @relation(fields: [agentId], references: [id])
  zoneId             String?
  zone               TarifZone?        @relation(fields: [zoneId], references: [id])
  contrat            Contrat?
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, numeroReservation])  // Numéro unique par tenant
  @@index([tenantId])
  @@map("reservations")
}

// ---- Contrats ----

model Contrat {
  id                String        @id @default(uuid())
  numeroContrat     String        @unique
  reservation       Reservation   @relation(fields: [reservationId], references: [id])
  reservationId     String        @unique
  client            Client        @relation(fields: [clientId], references: [id])
  clientId          String
  agent             User          @relation(fields: [agentId], references: [id])
  agentId           String
  dateSignature     DateTime      @default(now())
  kilometrageDepart Int
  kilometrageRetour Int?
  etatDepart        String
  etatRetour        String?
  caution           Decimal       @db.Decimal(10, 2)
  cautionRendue     Boolean       @default(false)
  notes             String?
  paiements         Paiement[]
  statut            StatutContrat @default(ACTIF)
  pdfUrl            String?
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId])
  @@map("contrats")
}

// ---- Paiements ----

model Paiement {
  id           String          @id @default(uuid())
  contrat      Contrat         @relation(fields: [contratId], references: [id])
  contratId    String
  montant      Decimal         @db.Decimal(10, 2)
  methode      MethodePaiement
  reference    String?
  datePaiement DateTime        @default(now())
  notes        String?
  valide       Boolean         @default(true)
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId])
  @@map("paiements")
}

// ---- Maintenances ----

model Maintenance {
  id          String            @id @default(uuid())
  vehicule    Vehicule          @relation(fields: [vehiculeId], references: [id])
  vehiculeId  String
  type        String
  description String
  cout        Decimal?          @db.Decimal(10, 2)
  dateDebut   DateTime
  dateFin     DateTime?
  statut      StatutMaintenance @default(EN_COURS)
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
  @@map("maintenances")
}

// ---- Journal d'activité ----

model JournalActivite {
  id        String   @id @default(uuid())
  userId    String
  userNom   String
  userRole  String
  action    String
  entite    String
  entiteId  String?
  details   Json?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("journal_activite")
}

// ---- Zones tarifaires ----

model TarifZone {
  id             String          @id @default(uuid())
  nom            String
  actif          Boolean         @default(true)
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  prixCategories PrixCategorie[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([nom, tenantId])  // Nom unique par tenant
  @@index([tenantId])
  @@map("tarif_zones")
}

// ---- Grille tarifaire ----

model PrixCategorie {
  id             String    @id @default(uuid())
  categorie      Categorie
  zone           TarifZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId         String
  prixJournalier Decimal   @db.Decimal(10, 2)
  prixSemaine    Decimal?  @db.Decimal(10, 2)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([categorie, zoneId])
  @@index([tenantId])
  @@map("prix_categories")
}

// ---- Paramètres par tenant ----

model Parametre {
  id            String   @id @default(uuid())
  tenantId      String   @unique  // Un seul jeu de paramètres par tenant
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nomEntreprise String   @default("Mon Entreprise")
  slogan        String   @default("Location de Véhicules")
  activite      String   @default("Vente et location de voitures")
  telephone     String   @default("")
  telephone2    String   @default("")
  email         String   @default("")
  adresse       String   @default("")
  ville         String   @default("")
  rccm          String   @default("")
  ninea         String   @default("")
  heuresLunVen  String   @default("08h00 – 18h00")
  heuresSamedi  String   @default("09h00 – 15h00")
  noteTransfert String   @default("Transfert aéroport disponible 24h/24 sur réservation")
  bannierePromo  String?
  promoSousTexte String?
  promoReduction String?
  promoDateFin   String?
  updatedAt      DateTime @updatedAt

  @@map("parametres")
}

// ---- Paiements d'abonnement SaaS ----

model PaiementAbonnement {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  montant   Decimal  @db.Decimal(10, 2)
  methode   String   // ESPECES, WAVE, ORANGE_MONEY, FREE_MONEY, VIREMENT, CHEQUE
  reference String?
  periode   String   // "2026-03" (AAAA-MM)
  notes     String?
  pdfUrl    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("paiements_abonnement")
}

// ---- Configuration des plans (plateforme, sans tenantId) ----

model PlanConfig {
  id             String   @id @default(uuid())
  code           String   @unique  // STARTER, PRO, ENTERPRISE
  nom            String
  description    String?
  montantMensuel Decimal  @db.Decimal(10, 2)
  montantAnnuel  Decimal? @db.Decimal(10, 2)
  maxAgents      Int      @default(3)
  maxVehicules   Int      @default(20)
  features       Json     @default("[]")
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("plan_configs")
}

// ---- Tokens révoqués ----

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}
