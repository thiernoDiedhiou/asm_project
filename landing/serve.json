{
  "rewrites": [
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/",        "type": 301 },
    { "source": "/contact.html", "destination": "/contact", "type": 301 }
  ],
  "headers": [
    {
      "source": "**/*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
